# Salin menjadi .env.local lalu isi. Jangan pernah commit .env.local.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya dipakai di server (menandatangani URL berkas privat). JANGAN diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Akun khusus Buku Harapan. Hanya dibaca di server, tidak pernah dikirim ke browser.
# Email dan kata sandi ini harus sama dengan akun yang dibuat di Supabase Authentication.
BUKU_HARAPAN_EMAIL=
BUKU_HARAPAN_PASSWORD=

# Untuk pengembangan: true = situs selalu terbuka (melewati kunci countdown).
# Di produksi biarkan kosong atau false agar kejutan terkunci sampai hari H.
NEXT_PUBLIC_FORCE_OPEN=false

# Alamat situs (untuk tautan masuk Buku Harapan)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opsional: mengamankan endpoint /api/keepalive yang dipanggil cron Vercel
CRON_SECRET=
